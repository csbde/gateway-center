# Gateway Center · 参考编排环境变量模板（T006）
#
# 用法：
#   cd deploy/compose
#   cp .env.example .env
#   # 编辑 .env：至少填写 GC_MASTER_KEY 与 GC_INITIAL_ADMIN_PASSWORD
#   docker compose up -d
#
# compose 读取本目录 .env 做两件事：
#   1) ${VAR} 插值（如 postgres 凭证、GC_PORT）；
#   2) 经 env_file 注入容器（所有 GC_* 自动到达后端二进制）。
# GC_DATABASE_URL 由 postgres 凭证自动拼接，勿在此设置。
#
# 本文件仅作模板，勿填入真实密钥；.env 已在 .gitignore 中（宪法 VIII）。

# ---- PostgreSQL（compose 内 postgres 服务凭证）----
POSTGRES_USER=gc
POSTGRES_PASSWORD=gc
POSTGRES_DB=gc

# ---- 控制平面端口（容器内固定 :8080；此处仅宿主映射）----
GC_PORT=8080

# ---- 控制平面必填 ----
# 32 字节主密钥（64 hex，AES-256-GCM）。生成：openssl rand -hex 32
# 丢失即无法解密已存凭证/私钥，请离线备份（宪法 VIII：不落库不落仓库）。
GC_MASTER_KEY=

# 初始 Super Admin（migrate-seed 幂等创建；密码 ≥12 字符）
GC_INITIAL_ADMIN_USERNAME=admin
GC_INITIAL_ADMIN_PASSWORD=

# ---- 可选（留空则用后端默认值）----
# GC_JWT_SECRET=            # 缺省由 MasterKey 派生，避免复用加密密钥本身
# GC_ACCESS_TOKEN_TTL=2h
# GC_REFRESH_TOKEN_TTL=168h
# GC_PROBE_INTERVAL=30s
